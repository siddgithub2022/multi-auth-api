{
  "openapi": "3.0.3",
  "info": {
    "title": "Multi-Auth API - oauth1a",
    "version": "1.0.0",
    "description": "Demonstrates Non-Auth, Basic, Digest, OAuth 1.0, OAuth 1.0a, OAuth 2.0 with realtime (WS, SSE, Socket.IO) - Single BaseUrl for all auth types"
  },
  "servers": [
    {
      "url": "http://192.168.0.45:3000",
      "description": "Single BaseUrl for all auth types - Dedicated Server"
    }
  ],
  "tags": [
    {
      "name": "OAuth 1.0a",
      "description": "OAuth 1.0a 3-legged"
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      },
      "digestAuth": {
        "type": "http",
        "scheme": "digest"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "oauth1": {
        "type": "oauth2",
        "flows": {}
      },
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "http://192.168.0.45:3000/api/oauth2/authorize",
            "tokenUrl": "http://192.168.0.45:3000/api/oauth2/token",
            "scopes": {
              "read": "read",
              "write": "write"
            }
          },
          "clientCredentials": {
            "tokenUrl": "http://192.168.0.45:3000/api/oauth2/token",
            "scopes": {
              "read": "read"
            }
          },
          "password": {
            "tokenUrl": "http://192.168.0.45:3000/api/oauth2/token",
            "scopes": {
              "read": "read",
              "write": "write"
            }
          }
        }
      }
    },
    "schemas": {
      "RealtimePayload": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "stocks": {
            "type": "array"
          },
          "crypto": {
            "type": "array"
          },
          "sensors": {
            "type": "object"
          },
          "metrics": {
            "type": "object"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/api/oauth1a/request_token": {
      "post": {
        "tags": [
          "OAuth 1.0a"
        ],
        "summary": "Get request token",
        "responses": {
          "200": {
            "description": "token"
          }
        }
      },
      "get": {
        "tags": [
          "OAuth 1.0a"
        ],
        "summary": "Get request token (GET)",
        "responses": {
          "200": {
            "description": "token"
          }
        }
      }
    },
    "/api/oauth1a/authorize": {
      "get": {
        "tags": [
          "OAuth 1.0a"
        ],
        "summary": "Authorize request token",
        "parameters": [
          {
            "name": "oauth_token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "verifier"
          }
        }
      }
    },
    "/api/oauth1a/access_token": {
      "post": {
        "tags": [
          "OAuth 1.0a"
        ],
        "summary": "Exchange for access token",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "oauth_token": {
                    "type": "string"
                  },
                  "oauth_verifier": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "access token"
          }
        }
      }
    },
    "/api/oauth1a/data": {
      "get": {
        "tags": [
          "OAuth 1.0a"
        ],
        "summary": "OAuth1a data (needs access token)",
        "security": [
          {
            "oauth1": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}